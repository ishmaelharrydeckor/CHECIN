rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // ChecIN Multi-Tenant Security Rules
    // Tenancy & authorization derive exclusively from verified custom claims:
    // request.auth.token: { role: 'org_admin' | 'manager' | 'employee', orgId, managerId }
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function orgId() {
      return isSignedIn() ? request.auth.token.orgId : null;
    }

    function managerId() {
      return isSignedIn() ? request.auth.token.managerId : null;
    }

    function isOrgAdmin() {
      return isSignedIn() && role() == "org_admin";
    }

    function isManager() {
      return isSignedIn() && role() == "manager";
    }

    function inOrg(data) {
      return isSignedIn() && orgId() != null && data.orgId == orgId();
    }

    function isOwnTeam(data) {
      return inOrg(data) && managerId() != null && data.managerId == managerId();
    }

    // ---- 1. Organizations (Hard Isolation Boundary) ----
    match /organizations/{targetOrgId} {
      // Any signed-in member of this organization can read its metadata
      allow read: if isSignedIn() && orgId() == targetOrgId;
      // Only org_admin can update organization details, and only display fields —
      // plan/billing, createdById etc. are server-managed (Admin SDK only)
      allow update: if isOrgAdmin() && orgId() == targetOrgId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "timezone", "updatedAt"]);
      // Creation and deletion managed exclusively by server Admin SDK
      allow create, delete: if false;
    }

    // ---- 2. Users (Display Profile Only — NEVER stores a role field or modifies tenancy) ----
    match /users/{userId} {
      // Self; org admin (whole org); manager (own team only). Employees cannot read coworkers.
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (inOrg(resource.data) && (isOrgAdmin() || (isManager() && resource.data.managerId == request.auth.uid)))
      );
      // Create: display fields only. Tenancy/team fields (orgId, managerId) and anything
      // role-like are set exclusively by the server (Admin SDK).
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["id", "email", "displayName", "photoURL", "department", "createdAt", "updatedAt"]);
      // Update: only the same display fields may change
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["id", "email", "displayName", "photoURL", "department", "createdAt", "updatedAt"]);
      allow delete: if false;
    }

    // ---- 3. Locations (Physical entrance & office locations) ----
    // Holds NO secrets. Holds name, orgId, createdAt.
    match /locations/{locationId} {
      allow read: if inOrg(resource.data);
      allow create: if isOrgAdmin() && inOrg(request.resource.data);
      allow update, delete: if isOrgAdmin() && inOrg(resource.data);
    }

    // ---- 4. Clock Events (Append-only physical presence scan logs) ----
    match /clock_events/{eventId} {
      // Employee reads own; Manager reads team's; Org Admin reads org-wide
      allow read: if inOrg(resource.data) && (
        isOrgAdmin() ||
        (isManager() && resource.data.managerId == request.auth.uid) ||
        resource.data.employeeId == request.auth.uid
      );
      // CREATION & MODIFICATION LOCKED: Created exclusively via verified-scan server route
      // No client may write directly to clock_events
      allow create, update, delete: if false;
    }

    // ---- 5. Leave Requests ----
    match /leave_requests/{requestId} {
      // Employee reads own; Manager reads team; Admin reads org
      allow read: if inOrg(resource.data) && (
        isOrgAdmin() ||
        (isManager() && resource.data.managerId == request.auth.uid) ||
        resource.data.employeeId == request.auth.uid
      );
      // Employee creates their own leave request within their org & team.
      // Always starts as pending (an employee cannot self-approve). Only the known fields
      // are allowed, the type must be one of the listed kinds, dates must be YYYY-MM-DD with
      // the end on or after the start, the note is capped, and createdAt must be the server time.
      allow create: if inOrg(request.resource.data)
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.managerId == managerId()
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(["orgId", "managerId", "employeeId", "type", "startDate", "endDate", "note", "status", "createdAt"])
        && request.resource.data.type in ["annual", "sick", "personal", "unpaid", "other"]
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate >= request.resource.data.startDate
        && (!("note" in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && request.resource.data.createdAt == request.time;
      // Manager approves/denies within their own team; Org Admin can override. A decision can be
      // made ONCE: only a pending request can change, only to approved or denied, recorded under the
      // reviewer's own uid and the server time. A manager cannot decide their own request (it goes to an
      // org admin); an org admin may decide their own, so a sole admin is never stuck.
      // Only the decision fields may change (not employee, team, dates or type).
      allow update: if inOrg(resource.data) && (
        (isManager() && resource.data.managerId == request.auth.uid) ||
        isOrgAdmin()
      )
        && (resource.data.employeeId != request.auth.uid || isOrgAdmin())
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "denied"]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedBy", "reviewedAt"]);
      allow delete: if false;
    }

    // ---- 6. Announcements (Company & Team notice boards) ----
    match /announcements/{announcementId} {
      // All org members read announcements
      allow read: if inOrg(resource.data);
      // Org Admin can create org-wide; Manager can create team announcements
      allow create: if inOrg(request.resource.data) && (
        isOrgAdmin() ||
        (isManager() && request.resource.data.managerId == request.auth.uid)
      );
      allow update, delete: if inOrg(resource.data) && (
        isOrgAdmin() ||
        (isManager() && resource.data.managerId == request.auth.uid)
      );
    }

    // ---- 7. User Devices (Active sessions & audit) ----
    match /user_devices/{deviceDocId} {
      allow read: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // ---- Holidays (public holiday calendar, task 2.5) ----
    match /holidays/{holidayId} {
      // Everyone in the organization can read
      allow read: if inOrg(resource.data);
      // Only org_admin writes; only date + name, no extra fields; orgId can never change
      allow create: if isOrgAdmin() && inOrg(request.resource.data)
        && request.resource.data.keys().hasOnly(["orgId", "date", "name"])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if isOrgAdmin() && inOrg(resource.data)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.keys().hasOnly(["orgId", "date", "name"])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if isOrgAdmin() && inOrg(resource.data);
    }

    // =========================================================================
    // 🔒 LOCKED COLLECTIONS (Admin SDK Only — allow read, write: if false)
    // No direct client read or write permitted under any circumstances
    // =========================================================================

    // Kiosks: Holds kiosk_secret_hash & pairing timestamps (never readable from client)
    match /kiosks/{locationId} {
      allow read, write: if false;
    }

    // Kiosk Pairings: 10-minute expiring single-use pairing codes
    match /kiosk_pairings/{code} {
      allow read, write: if false;
    }

    // Staff Invites: 7-day single-use email-bound invite tokens
    match /staff_invites/{token} {
      allow read, write: if false;
    }

    // Rate Limiting: Persistent distributed counters
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Web Push: Subscriptions, notification preferences, in-app messages
    match /push_subscriptions/{subId} {
      allow read, write: if false;
    }
    match /in_app_notifications/{notifId} {
      allow read, write: if false;
    }
    match /notification_preferences/{prefId} {
      allow read, write: if false;
    }

    // Problem reports and their screenshots: written and read only by the server (/api/reports),
    // and only the platform owner can read them there. No client access, ever.
    match /problem_reports/{reportId} {
      allow read, write: if false;
    }
    match /problem_report_files/{reportId} {
      allow read, write: if false;
    }

    // Recent Scans: Ephemeral scan notifications read exclusively by Admin SDK in /api/kiosk/token
    match /recent_scans/{locationId} {
      allow read, write: if false;
    }

    // Default Deny: Catch-all for any collection not explicitly matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
