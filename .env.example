# ---------------------------------------------------------------------------
# Firebase client SDK config (public, safe to ship in the client bundle).
# These normally come from firebase-applet-config.json; only set these if
# your setup overrides that file with env vars instead.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK credentials — REQUIRED on Vercel.
#
# Vercel has no ambient Google identity, so Application Default Credentials
# do not work there. Every student-facing route (portal login, self check-in,
# portal registration, TA invites, push notifications) depends on the Admin
# SDK, so without this the whole portal returns 500s.
#
# Get it from: Firebase Console > Project Settings > Service Accounts >
# "Generate new private key".
#
# Paste either the raw JSON, or (recommended, avoids newline mangling in the
# Vercel UI) its base64 encoding:
#   base64 -w0 service-account.json      # Linux
#   base64 -i service-account.json       # macOS
#
# Set this in Vercel under Settings > Environment Variables for every
# environment you deploy (Production, Preview, Development).
# NEVER commit the actual value.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Signs short-lived student session tokens (10 min TTL), used only to prove
# "this index number just logged in successfully" for the one call right
# after login (registering a push subscription). See
# src/lib/student-session.server.ts.
#
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
STUDENT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Web Push (VAPID) keys — REQUIRED, no hardcoded fallback exists anymore.
#
# The keypair previously hardcoded in src/lib/push-service.server.ts and
# src/lib/push-client.ts was committed to this public repo and must be
# treated as compromised. Generate a fresh pair and use ONLY these:
#   npx web-push generate-vapid-keys
#
# VAPID_PRIVATE_KEY is a real secret — set it here, never in source.
# VAPID_PUBLIC_KEY / VITE_VAPID_PUBLIC_KEY are the same public value; the
# VITE_ prefixed copy is what actually ships to the browser bundle.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:project1232026@gmail.com
VITE_VAPID_PUBLIC_KEY=
