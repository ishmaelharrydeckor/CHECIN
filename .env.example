# ---------------------------------------------------------------------------
# Firebase Client SDK Config (Public, safe to ship in client bundle)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK Credentials (REQUIRED on Vercel / Node server)
#
# Vercel has no ambient Google identity, so Application Default Credentials
# do not work there. The server routes (auth claims, staff invites, check-in,
# push notifications) depend on the Admin SDK.
#
# Get it from: Firebase Console > Project Settings > Service Accounts >
# "Generate new private key".
#
# Paste either the raw JSON, or (recommended, avoids newline mangling in the
# Vercel UI) its base64 encoding:
#   base64 -w0 service-account.json      # Linux
#   base64 -i service-account.json       # macOS
#
# Set this in Vercel under Settings > Environment Variables for every
# environment you deploy (Production, Preview, Development).
# NEVER commit the actual value.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=

# ---------------------------------------------------------------------------
# Physical Kiosk & Session Cryptography
# Signs rotating 15-second kiosk HMAC presence tokens.
# REQUIRED — no hardcoded fallback exists.
#
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
KIOSK_TOKEN_SECRET=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Web Push (VAPID) Keys — REQUIRED for notifications
#
# Generate a fresh pair with:
#   npx web-push generate-vapid-keys
#
# VAPID_PRIVATE_KEY is a real secret — set it in environment, never in source.
# VAPID_PUBLIC_KEY / VITE_VAPID_PUBLIC_KEY are the public value; the
# VITE_ prefixed copy is what ships to the browser bundle.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@checin.app
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Public Application Origin (for invite links and redirect deep-links)
# ---------------------------------------------------------------------------
APP_ORIGIN=https://checin.app
VITE_APP_ORIGIN=https://checin.app

# ---------------------------------------------------------------------------
# Platform owner (who can read problem reports)
#
# Comma-separated Firebase user ids (Firebase Console > Authentication > Users >
# "User UID"). These people see the Reports inbox and get a notification for each
# new report. It is NOT a company role: a company admin can never read reports.
# Leave empty and nobody can read them. Use a DIFFERENT value per environment, because
# staging and production are separate Firebase projects with separate user ids.
# ---------------------------------------------------------------------------
PLATFORM_OWNER_UIDS=
