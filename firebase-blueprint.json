{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Company or enterprise tenant boundary in ChecIN.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "plan": { "type": "string" },
        "timezone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "User profile with display fields only (roles live in custom claims).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "orgId": { "type": "string" },
        "department": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "orgId"]
    },
    "Location": {
      "title": "Location",
      "description": "Physical entrance terminal location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orgId", "name"]
    },
    "ClockEvent": {
      "title": "ClockEvent",
      "description": "Immutable check-in/out attendance event verified by physical presence.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "orgId": { "type": "string" },
        "managerId": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "employeeEmail": { "type": "string" },
        "department": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "timestamp": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "verifiedBy": { "type": "string" }
      },
      "required": ["eventId", "orgId", "employeeId", "type", "timestamp", "locationId"]
    }
  },
  "firestore": {
    "/organizations/{orgId}": { "schema": "Organization" },
    "/users/{userId}": { "schema": "User" },
    "/locations/{locationId}": { "schema": "Location" },
    "/clock_events/{eventId}": { "schema": "ClockEvent" }
  }
}
