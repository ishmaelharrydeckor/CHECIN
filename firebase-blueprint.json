{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered administrator, lecturer, or staff member in QRoll.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The verified email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "Full display name of the user."
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL."
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "lecturer", "teaching_assistant"],
          "description": "Access level and administrative role."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of last profile update."
        }
      },
      "required": ["id", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record with index number, level, program, and QR code token.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "full_name": { "type": "string" },
        "index_number": { "type": "string" },
        "level": { "type": "string" },
        "program": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "qr_uuid": { "type": "string" }
      },
      "required": ["full_name", "index_number"]
    },
    "Course": {
      "title": "Course",
      "description": "Course offered by a department or lecturer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "department_id": { "type": "string" },
        "level": { "type": "string" },
        "credit_hours": { "type": "number" }
      },
      "required": ["owner_id", "code", "title"]
    },
    "Department": {
      "title": "Department",
      "description": "Department or faculty division in the institution.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["owner_id", "name"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Live or concluded attendance lecture session with QR verification token.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "course_id": { "type": "string" },
        "title": { "type": "string" },
        "session_code": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["owner_id", "course_id", "title"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual student attendance verification log for a session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "student_id": { "type": "string" },
        "index_number": { "type": "string" },
        "status": { "type": "string" },
        "check_in_at": { "type": "string" }
      },
      "required": ["session_id", "index_number"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Device Web Push subscription tokens for background push notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userRole": { "type": "string" },
        "endpoint": { "type": "string" },
        "keys": { "type": "object" },
        "platform": { "type": "string" },
        "browser": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "endpoint", "keys"]
    },
    "InAppNotification": {
      "title": "InAppNotification",
      "description": "In-app alerts and notifications sent to users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "url": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "body"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and role metadata collection."
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Enrolled student records."
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Academic course definitions."
    },
    "/departments/{deptId}": {
      "schema": "Department",
      "description": "Academic department records."
    },
    "/attendance_sessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Class attendance session instances."
    },
    "/attendance_records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Recorded attendance logs per session."
    },
    "/push_subscriptions/{subId}": {
      "schema": "PushSubscription",
      "description": "Registered browser push subscriptions."
    },
    "/in_app_notifications/{notifId}": {
      "schema": "InAppNotification",
      "description": "Stored user alerts and notification history."
    }
  }
}
